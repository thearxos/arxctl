#!/usr/bin/env bash
# arxos-kernel — ArxOS kernel history + install/remove, driven by the public
# arxos-kernels manifest (kernels.json). Backs the Control Center Kernels tab.
#
# User-facing verbs (mirror `arx kernel`):
#   arxos-kernel list                        # every published kernel (flavor version status)
#   arxos-kernel install <flavor> [version]  # download + verify + install kernel + headers
#   arxos-kernel remove  <flavor>            # uninstall a kernel + headers (safely)
# GUI/parse verbs (used by the Control Center; stable machine output):
#   arxos-kernel history <flavor>            # plain-English feature diff per version
#   arxos-kernel latest  <flavor>            # the current (newest) version string
#   arxos-kernel current <flavor>            # installed version (or empty)
#
# The manifest is the source of truth (history, download URLs, sha256). When `arx`
# is present, install/remove delegate to the native `arx kernel` (fast, sha256
# fail-closed, running/last-kernel guards). Without `arx`, a pure-bash path runs so
# the tool still works on a system that has no arx-core yet.
set -uo pipefail
FLAVOR_DEFAULT="linux-arxos"
MANIFEST_URL="${ARXOS_KERNELS_MANIFEST:-https://raw.githubusercontent.com/thearxos/arxos-kernels/main/kernels.json}"
MANIFEST_LOCAL="${ARXOS_KERNELS_LOCAL:-/usr/share/arxos/kernels.json}"

_manifest(){ curl -fsSL "$MANIFEST_URL" 2>/dev/null || cat "$MANIFEST_LOCAL" 2>/dev/null; }
_py(){ local code="$1"; shift; _manifest | python3 -c "$code" "$@" 2>/dev/null; }
_have_arx(){ command -v arx >/dev/null 2>&1; }

# ---- machine-parseable views (stable for the Control Center) ----
list(){ _py '
import sys,json
m=json.load(sys.stdin);f=sys.argv[1]
for k in m.get("kernels",[]):
    if k["flavor"]==f: print(k["version"] + "\t" + k["status"])
' "${1:-$FLAVOR_DEFAULT}"; }

history(){ _py '
import sys,json
m=json.load(sys.stdin);f=sys.argv[1]
print("# " + f + " history\n")
for k in m.get("kernels",[]):
    if k["flavor"]!=f: continue
    print(k["version"] + "  (" + k["status"] + ")  base: " + k["upstream"] + "  " + k["date"])
    print("  " + k["changes"] + "\n")
print("What ArxOS adds to every kernel:")
for t in m.get("tunes",[]): print("  - " + t["name"] + ": " + t["advantage"])
' "${1:-$FLAVOR_DEFAULT}"; }

latest(){ _py '
import sys,json
m=json.load(sys.stdin);f=sys.argv[1]
print(m.get("flavors",{}).get(f,{}).get("current",""))
' "${1:-$FLAVOR_DEFAULT}"; }

current(){ pacman -Q "${1:-$FLAVOR_DEFAULT}" 2>/dev/null | awk '{print $2}'; }

# emit: base_url<TAB>kfile<TAB>ksha<TAB>hfile<TAB>hsha<TAB>status  for flavor+version
_resolve(){ _py '
import sys,json
m=json.load(sys.stdin);f,ver=sys.argv[1],sys.argv[2]
if not ver: ver=m.get("flavors",{}).get(f,{}).get("current","")
for k in m.get("kernels",[]):
    if k["flavor"]==f and k["version"]==ver:
        u=k.get("urls",{}); a=k["artifacts"]
        base=u.get("r2") if (k["status"]=="current" and u.get("r2")) else u.get("github")
        print("\t".join([base or "", a["kernel"]["file"], a["kernel"]["sha256"] or "",
                          a["headers"]["file"], a["headers"]["sha256"] or "", k["status"]]))
        break
' "$1" "$2"; }

# ---- pure-bash install fallback (only used when arx is absent) ----
_install_bash(){
  local f="${1:-$FLAVOR_DEFAULT}" ver="${2:-}"
  [ -n "$ver" ] || ver="$(latest "$f")"
  [ -n "$ver" ] || { echo "!! no version for $f in the manifest"; return 1; }
  local row; row="$(_resolve "$f" "$ver")"
  [ -n "$row" ] || { echo "!! $f $ver is not in the manifest"; return 1; }
  IFS=$'\t' read -r base kfile ksha hfile hsha status <<<"$row"
  [ -n "$base" ] || { echo "!! no download URL for $f $ver"; return 1; }
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  echo ">> fetching $f $ver ($status)..."
  curl -fL --progress-bar -o "$tmp/$kfile" "$base$kfile" || { echo "!! kernel download failed"; return 1; }
  curl -fL --progress-bar -o "$tmp/$hfile" "$base$hfile" || { echo "!! headers download failed"; return 1; }
  _check(){ local file="$1" want="$2"; [ -n "$want" ] || { echo "!! no sha256 in manifest for $file — refusing to install unverified"; return 1; }
            local got; got="$(sha256sum "$tmp/$file" | cut -d' ' -f1)"
            [ "$got" = "$want" ] || { echo "!! sha256 MISMATCH for $file"; echo "   want $want"; echo "   got  $got"; return 1; }
            echo "   verified $file"; }
  _check "$kfile" "$ksha" || return 1
  _check "$hfile" "$hsha" || return 1
  sudo pacman -U --noconfirm "$tmp/$kfile" "$tmp/$hfile" || return 1
  sudo grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
  echo ">> installed $f $ver — reboot to use it (or Set default in the Control Center)"
}

# ---- user-facing install/remove (prefer the native arx path) ----
install(){
  if _have_arx; then arx kernel install "${1:-$FLAVOR_DEFAULT}" ${2:+"$2"}; else _install_bash "${1:-$FLAVOR_DEFAULT}" "${2:-}"; fi
}
remove(){
  local f="${1:-$FLAVOR_DEFAULT}"
  if _have_arx; then arx kernel remove "$f"; return $?; fi
  # bash fallback: same two safety checks arx enforces (running + last kernel).
  local run; run="$(cat "/usr/lib/modules/$(uname -r)/pkgbase" 2>/dev/null)"
  [ "$run" != "$f" ] || { echo "!! $f is the kernel you are running — reboot into another first"; return 1; }
  local n; n="$(pacman -Qq 2>/dev/null | grep -Ex 'linux-arxos|linux-arxos-rt|linux|linux-lts|linux-zen|linux-hardened' | wc -l)"
  [ "$n" -gt 1 ] || { echo "!! $f is the only kernel installed — removing it would leave nothing to boot"; return 1; }
  pacman -Qq "$f" >/dev/null 2>&1 || { echo "!! $f is not installed"; return 1; }
  local t="$f"; pacman -Qq "$f-headers" >/dev/null 2>&1 && t="$t $f-headers"
  sudo pacman -Rns --noconfirm $t || return 1
  sudo grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
  echo ">> removed $f"
}

case "${1:-}" in
  list)    list "${2:-}" ;;
  history) history "${2:-}" ;;
  latest)  latest "${2:-}" ;;
  current) current "${2:-}" ;;
  install) install "${2:-}" "${3:-}" ;;
  remove)  remove "${2:-}" ;;
  _resolve) _resolve "${2:-}" "${3:-}" ;;
  *) echo "usage: arxos-kernel {list|install <flavor> [version]|remove <flavor>|history|latest|current} [flavor]"; exit 1 ;;
esac
